---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPublications } from '../../lib/content';

export const getStaticPaths = (async () => {
  const publications = await getPublications();
  return publications.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.excerpt} type="article">
  <article class="prose">
    <p class="meta"><span class="year">{entry.data.date.getFullYear()}</span> {entry.data.venue}</p>
    <h1>{entry.data.title}</h1>
    <Content />
    <div class="citation">
      <p class="label">Recommended citation</p>
      <p>{entry.data.citation}</p>
    </div>
  </article>
</Base>
