---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Video from '../../components/Video.astro';
import { getProjectsForPublication, getPublications } from '../../lib/content';

export const getStaticPaths = (async () => {
  const publications = await getPublications();
  return publications.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const projects = await getProjectsForPublication(entry);
---

<Base title={entry.data.title} description={entry.data.excerpt} type="article">
  <article class="prose">
    <p class="meta"><span class="year">{entry.data.date.getFullYear()}</span> {entry.data.venue}</p>
    <h1>{entry.data.title}</h1>
    {projects.length > 0 && (
      <p class="part-of label">
        Part of {projects.map((p, i) => <>{i > 0 && ', '}<a href={`/projects/${p.id}/`}>{p.data.title}</a></>)}
      </p>
    )}
    <Content />
    {data.video && <Video {...data.video} />}
    <div class="citation">
      <p class="label">Recommended citation</p>
      <p>{data.citation}</p>
      {data.doi && <p class="doi">DOI: <a href={`https://doi.org/${data.doi}`}>{data.doi}</a></p>}
      <details>
        <summary class="label">BibTeX</summary>
        <pre>{data.bibtex.trim()}</pre>
      </details>
    </div>
  </article>
</Base>
