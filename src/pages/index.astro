---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjects, getPublications } from '../lib/content';

const featured = (await getProjects()).filter((p) => p.data.featured);
const recent = (await getPublications()).slice(0, 3);
---

<Base>
  <section class="pitch">
    <h1>Thibault Noël</h1>
    <p class="lead">
      Robotics R&D engineer with a PhD in autonomous navigation (Inria). I work from high-level algorithms down
      to the hardware: planning and exploration, simulation, ROS 2 architecture, CAD and integration. Most
      recently, GNSS-denied navigation for UAVs in an early-stage startup. Open to robotics R&D roles.
    </p>
  </section>

  <h2>Projects</h2>
  <div class="card-grid">
    {featured.map((project) => <ProjectCard project={project} />)}
  </div>

  <h2>Recent publications</h2>
  <ul class="entry-list">
    {recent.map((p) => (
      <li>
        <p class="meta"><span class="year">{p.data.date.getFullYear()}</span> {p.data.venue}</p>
        <h3><a href={`/publications/${p.id}/`}>{p.data.title}</a></h3>
      </li>
    ))}
  </ul>
  <p class="more"><a href="/publications/">All publications →</a></p>
</Base>
