---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProjects, getPublications } from '../lib/content';

const featured = (await getProjects()).filter((p) => p.data.featured);
const recent = (await getPublications()).slice(0, 3);
---

<Base>
  <section class="pitch">
    <h1>Thibault Noël</h1>
    <p class="lead">
      Robotics engineer with a PhD from Inria (2025) on the autonomous exploration of unknown 3D environments.
      My work covers motion planning, navigation roadmaps and exploration strategies, from algorithms to
      deployment on real robots.
    </p>
  </section>

  <h2>Projects</h2>
  <div class="card-grid">
    {featured.map((project) => <ProjectCard project={project} />)}
  </div>

  <h2>Recent publications</h2>
  <ul class="entry-list">
    {recent.map((p) => (
      <li>
        <p class="meta"><span class="year">{p.data.date.getFullYear()}</span> {p.data.venue}</p>
        <h3><a href={`/publications/${p.id}/`}>{p.data.title}</a></h3>
      </li>
    ))}
  </ul>
  <p class="more"><a href="/publications/">All publications →</a></p>
</Base>
