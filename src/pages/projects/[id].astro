---
import type { GetStaticPaths } from 'astro';
import { getEntries, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../lib/content';
import 'katex/dist/katex.min.css';

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const publications = (await getEntries(data.publications)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base title={data.title} description={data.summary} type="article">
  <article class="prose">
    <p class="meta"><span class="year">{data.period}</span> {data.organisation}</p>
    <h1>{data.title}</h1>
    <p class="lead">{data.summary}</p>
    <dl class="facts">
      <div><dt>Role</dt><dd>{data.role}</dd></div>
      <div><dt>Organisation</dt><dd>{data.organisation}</dd></div>
      <div><dt>Period</dt><dd>{data.period}</dd></div>
    </dl>
    {data.skills.length > 0 && <ul class="tags">{data.skills.map((s) => <li>{s}</li>)}</ul>}
    {data.cover && (
      <Image class="cover" src={data.cover} alt={data.coverAlt ?? ''} widths={[800, 1400]} sizes="(max-width: 52rem) 100vw, 800px" />
    )}
    <Content />
    {publications.length > 0 && (
      <section>
        <h2>Publications</h2>
        <ul class="entry-list">
          {publications.map((p) => (
            <li>
              <p class="meta"><span class="year">{p.data.date.getFullYear()}</span> {p.data.venue}</p>
              <h3><a href={`/publications/${p.id}/`}>{p.data.title}</a></h3>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</Base>
