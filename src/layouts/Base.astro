---
import Head from '../components/Head.astro';
import { SITE } from '../site';
import { getPosts } from '../lib/content';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-400-italic.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
}

const hasPosts = (await getPosts()).length > 0;
const nav = [
  { label: 'Projects', href: '/projects/' },
  { label: 'Publications', href: '/publications/' },
  ...(hasPosts ? [{ label: 'Posts', href: '/posts/' }] : []),
  { label: 'Tools', href: '/tools/' },
  { label: 'About', href: '/about/' },
];
const path = Astro.url.pathname;
const revision = new Date().toISOString().slice(0, 10);
// Each top-level section is a "sheet" of the drawing set; detail pages belong to their section's sheet.
const sheets = [{ label: 'Home', href: '/' }, ...nav];
const sheetIndex = sheets.findIndex((s) => (s.href === '/' ? path === '/' : path.startsWith(s.href)));
const sheet = sheets[sheetIndex];
---

<!doctype html>
<html lang="en">
  <head>
    <Head {...Astro.props} />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header frame">
      <a class="site-title" href="/">
        <span class="site-name">{SITE.title}</span>
        <span class="site-tagline">{SITE.tagline}</span>
      </a>
      <nav>
        {nav.map((item) => (
          <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>
    </header>
    <div class="layout">
      <aside class="profile frame">
        <p class="box-tag label">Links</p>
        <ul>
          <li><a href={`mailto:${SITE.author.email}`}>Email</a></li>
          {SITE.links.map((l) => <li><a href={l.href} rel="me">{l.label}</a></li>)}
        </ul>
      </aside>
      <main class="frame">
        <p class="box-tag label">{path}</p>
        <div class="sheet-body">
          <slot />
        </div>
      </main>
    </div>
    <footer class="site-footer">
      <dl class="title-block frame">
        <div><dt>Author</dt><dd>{SITE.author.name}</dd></div>
        <div><dt>Sheet</dt><dd>{sheet?.label ?? Astro.props.title ?? '—'}</dd></div>
        <div><dt>Sheet no.</dt><dd>{sheet ? `${sheetIndex + 1} / ${sheets.length}` : '—'}</dd></div>
        <div><dt>Rev.</dt><dd>{revision}</dd></div>
        <div><dt>©</dt><dd>{revision.slice(0, 4)}</dd></div>
      </dl>
    </footer>
  </body>
</html>
