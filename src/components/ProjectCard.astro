---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { id, data } = Astro.props.project;
const media = data.preview ? { src: data.preview, alt: data.previewAlt } : data.cover && { src: data.cover, alt: data.coverAlt };
---

<a class="card" href={`/projects/${id}/`}>
  <div class="card-media">
    {media ? (
      <Image src={media.src} alt={media.alt ?? ''} widths={[400, 800]} sizes="(max-width: 52rem) 100vw, 400px" />
    ) : (
      <span class="card-media-empty label">{data.organisation}</span>
    )}
  </div>
  <div class="card-body">
    <p class="meta"><span class="year">{data.period}</span></p>
    <h3>{data.title}</h3>
    <p>{data.summary}</p>
    <ul class="tags">{data.skills.map((s) => <li>{s}</li>)}</ul>
  </div>
</a>
